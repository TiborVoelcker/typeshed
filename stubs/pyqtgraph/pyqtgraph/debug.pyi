class ObjTracker:
    allObjs: ClassVar[dict[int, None]]  # a set of the ids of this class's own objects
    startRefs: dict[int, ReferenceType[Any] | None]  # maps {id(obj): weakref}, None if not weak-referenceable
    startCount: dict[type, int]
    newRefs: dict[int, ReferenceType[Any] | None]
    persistentRefs: dict[int, ReferenceType[Any] | None]
    objTypes: dict[int, str]
    objs: list[Incomplete]
    def __init__(self) -> None: ...
    def findNew(self, regex: str) -> list[Incomplete]: ...
    def findPersistent(self, regex: str) -> list[Incomplete]: ...
    def start(self) -> None: ...
    def diff(self, **kargs) -> None: ...  # accepts `showIDs`, passed on to report()
    def __del__(self) -> None: ...
    @classmethod
    def isObjVar(cls, o: object) -> bool: ...
    def collect(self) -> tuple[dict[int, ReferenceType[Any] | None], dict[type, int], dict[int, Incomplete]]: ...
    def forgetRef(self, ref: ReferenceType[Any] | None) -> None: ...
    def rememberRef(self, ref: ReferenceType[Any] | None) -> None: ...
    def lookup(self, oid: int, ref: ReferenceType[Any] | None, objs: Mapping[int, Incomplete] | None = None): ...
    def report(
        self,
        refs: Mapping[int, ReferenceType[Any] | None],
        allobjs: Mapping[int, Incomplete] | None = None,
        showIDs: bool = False,
    ) -> None: ...
    def findTypes(self, refs: Mapping[int, ReferenceType[Any] | None], regex: str) -> list[Incomplete]: ...

