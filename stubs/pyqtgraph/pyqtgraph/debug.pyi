class Profiler:
    # The comma-separated contents of the PYQTGRAPHPROFILE environment variable: the
    # qualified names of the functions whose profilers are enabled.
    _profilers: ClassVar[list[str]]
    _depth: ClassVar[int]
    _msgs: ClassVar[list[tuple[str, tuple[Incomplete, ...]]]]  # maps {format string: args}
    # Set on the class to disable every profiler, or on an instance to disable just that one.
    disable: bool

    class DisabledProfiler:
        def __init__(self, *args, **kwds) -> None: ...
        def __call__(self, *args) -> None: ...
        def finish(self) -> None: ...
        def mark(self, msg: str | None = None) -> None: ...

    _disabledProfiler: ClassVar[DisabledProfiler]
    # Returns `Profiler._disabledProfiler` — a no-op with the same `__call__`/`mark`/`finish`
    # surface — when `disabled` is True, or when it is "env" and the caller's qualified name is
    # not listed in PYQTGRAPHPROFILE. That union is not expressible: `__new__` may only return a
    # subtype of its own class.
    def __new__(cls, msg: str | None = None, disabled: bool | Literal["env"] = "env", delayed: bool = True) -> Self: ...
    def __call__(self, msg: str | None = None) -> None: ...
    def mark(self, msg: str | None = None) -> None: ...
    def __del__(self) -> None: ...
    def finish(self, msg: str | None = None) -> None: ...
    def flush(self) -> None: ...

